{
  "policies": [
    {
      "id": "synthetic-deployment-role",
      "document": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "WideAdmin",
            "Effect": "Allow",
            "Action": "*",
            "Resource": "*"
          },
          {
            "Sid": "PublicRead",
            "Effect": "Allow",
            "Principal": "*",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::example/*"
          }
        ]
      }
    }
  ]
}
